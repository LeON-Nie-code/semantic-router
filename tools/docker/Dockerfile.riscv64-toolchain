# Native RISC-V builder; context is the four official archives listed below.
# Use its resulting image as both GO_IMAGE and RUST_IMAGE for router-attached.
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}
RUN test "$(dpkg --print-architecture)" = riscv64 \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential busybox ca-certificates curl git cmake pkg-config protobuf-compiler \
    libssl-dev python3 xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /bin/busybox /usr/local/bin/tar
COPY go1.25.14.linux-riscv64.tar.gz rustc-1.90.0-riscv64gc-unknown-linux-gnu.tar.xz cargo-1.90.0-riscv64gc-unknown-linux-gnu.tar.xz rust-std-1.90.0-riscv64gc-unknown-linux-gnu.tar.xz /archives/
RUN cd /archives && printf '%s\n' \
    'c47a1bd1ca1fef087920c9a5d648af77a90071f5af305b6e4c426a3dea982983  go1.25.14.linux-riscv64.tar.gz' \
    '11ae522969c6b18ad4b5a1ae229473de59406af7ab2e831acb43ee247a16b58d  rustc-1.90.0-riscv64gc-unknown-linux-gnu.tar.xz' \
    '8a09de014f7cec749b338c6636d190a1b73fd377bab6a223eb715d3c76c49e79  cargo-1.90.0-riscv64gc-unknown-linux-gnu.tar.xz' \
    '675dc5556d9d879101d2401b693fcf79edac8f00a49249e2e0f19cecd172ce51  rust-std-1.90.0-riscv64gc-unknown-linux-gnu.tar.xz' | sha256sum -c - \
    && tar -xzf go1.25.14.linux-riscv64.tar.gz -C /usr/local \
    && for component in rustc cargo rust-std; do \
      package="$component-1.90.0-riscv64gc-unknown-linux-gnu"; \
      tar -xJf "$package.tar.xz"; \
      bash "$package/install.sh" --prefix=/opt/rust --disable-ldconfig; \
    done \
    && rm -rf /archives
ENV PATH="/usr/local/go/bin:/opt/rust/bin:${PATH}"
ENV CARGO_BUILD_JOBS=2 GOMAXPROCS=2
RUN go version && rustc --version && cargo --version
